# Local shell checklist for remote worker deployments.
# Copy to deploy/.env.local (git-ignored) or export the values directly.
# Never commit real values.

# Bearer token the worker requires. The same value goes into the Modal secret
# imagen-worker-auth and into `imagen remote add --credential-ref env:IMAGEN_WORKER_TOKEN`.
IMAGEN_WORKER_TOKEN=

# Salad Container Gateway key. Only needed for SaladCloud endpoints.
SALAD_API_KEY=

# Optional image and GPU overrides. The published dev image is
# ghcr.io/nekoccn/imagen-worker:dev (public package).
IMAGEN_WORKER_IMAGE=ghcr.io/nekoccn/imagen-worker:dev
IMAGEN_MODAL_GPU=L4
